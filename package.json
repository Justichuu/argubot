{
  "name": "argubot",
  "version": "1.2.0",
  "description": "A funny, aggressively nonbiased argument bot. It argues both sides of anything and refuses to pick one.",
  "type": "module",
  "bin": {
    "argubot": "./bin/argubot.js"
  },
  "main": "./src/argubot.js",
  "exports": {
    ".": "./src/argubot.js"
  },
  "scripts": {
    "test": "node --test && node scripts/validate.js",
    "validate": "node scripts/validate.js",
    "start": "node bin/argubot.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "cli",
    "debate",
    "argument",
    "nonbiased",
    "gary",
    "civic"
  ],
  "license": "MIT",
  "private": true
}
